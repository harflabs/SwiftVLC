+/* Track unresolved failures, independently of diagnostic history. Decoder
+ * output retries contribute once until recovery; failures in other streams
+ * remain outstanding. All access belongs to the player lock. */
+#ifndef VLC_PLAYER_INPUT_FAILURE_H
+#define VLC_PLAYER_INPUT_FAILURE_H
+
+#include <limits.h>
+
+#define VLC_INPUT_FAILURE_KINDS (VLC_INPUT_FAILURE_OUTPUT + 1)
+struct vlc_player_input_failures
+{
+    unsigned counts[VLC_INPUT_FAILURE_KINDS];
+    enum vlc_input_failure_kind order[VLC_INPUT_FAILURE_KINDS];
+    unsigned length;
+};
+
+static inline void
+vlc_player_input_RecordFailure(struct vlc_player_input_failures *state,
+                               enum vlc_input_failure_kind kind)
+{
+    if ((unsigned) kind >= VLC_INPUT_FAILURE_KINDS)
+        kind = VLC_INPUT_FAILURE_UNKNOWN;
+    if (state->counts[kind] == 0)
+        state->order[state->length++] = kind;
+    if (state->counts[kind] != UINT_MAX)
+        state->counts[kind]++;
+}
+
+static inline void
+vlc_player_input_RecoverFailure(struct vlc_player_input_failures *state,
+                                enum vlc_input_failure_kind kind)
+{
+    if (kind != VLC_INPUT_FAILURE_RENDERER && kind != VLC_INPUT_FAILURE_OUTPUT &&
+        kind != VLC_INPUT_FAILURE_DECODER)
+        return;
+    /* Saturation is conservatively sticky; never clear an uncounted failure. */
+    if (state->counts[kind] == 0 || state->counts[kind] == UINT_MAX ||
+        --state->counts[kind] != 0)
+        return;
+    for (unsigned i = 0; i < state->length; ++i)
+    {
+        if (state->order[i] != kind) continue;
+        for (unsigned j = i + 1; j < state->length; ++j)
+            state->order[j - 1] = state->order[j];
+        state->length--;
+        break;
+    }
+}
+
+static inline enum vlc_player_error
+vlc_player_input_CurrentFailure(const struct vlc_player_input_failures *state)
+{
+    if (state->length == 0) return VLC_PLAYER_ERROR_NONE;
+    switch (state->order[0])
+    {
+        case VLC_INPUT_FAILURE_SOURCE: return VLC_PLAYER_ERROR_SOURCE;
+        case VLC_INPUT_FAILURE_DEMUX: return VLC_PLAYER_ERROR_DEMUX;
+        case VLC_INPUT_FAILURE_DECODER: return VLC_PLAYER_ERROR_DECODER;
+        case VLC_INPUT_FAILURE_RENDERER: return VLC_PLAYER_ERROR_RENDERER;
+        case VLC_INPUT_FAILURE_OUTPUT: return VLC_PLAYER_ERROR_OUTPUT;
+        default: return VLC_PLAYER_ERROR_GENERIC;
+    }
+}
+#endif
