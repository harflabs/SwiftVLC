+static void Decoder_ReportFailure(vlc_input_decoder_t *owner,
+                                        enum vlc_input_failure_kind kind)
+{
+    if (owner->reported_failures & (1u << kind))
+        return;
+    owner->reported_failures |= 1u << kind;
+    decoder_Notify(owner, on_failure, kind);
+}
+
+static void Decoder_ReportRecovery(vlc_input_decoder_t *owner,
+                                         enum vlc_input_failure_kind kind)
+{
+    if (!(owner->reported_failures & (1u << kind)))
+        return;
+    owner->reported_failures &= ~(1u << kind);
+    decoder_Notify(owner, on_recovery, kind);
+}
 
