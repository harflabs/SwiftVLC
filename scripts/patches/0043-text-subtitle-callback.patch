+
+static swiftvlc_webvtt_placement_t
+GetCueSwiftVLCPlacement( const webvtt_dom_cue_t *p_cue )
+{
+    swiftvlc_webvtt_placement_t placement = { 0 };
+    const float position = GetCuePosition( p_cue );
+    const enum webvtt_align_e position_alignment =
+        GetCuePositionAlignment( p_cue );
+    const bool horizontal =
+        p_cue->settings.vertical == WEBVTT_ALIGN_AUTO;
+
+    if( horizontal )
+    {
+        placement.horizontal_position = position;
+        placement.horizontal_anchor =
+            GetCueHorizontalPositionAnchor( position_alignment );
+    }
+    else
+    {
+        placement.vertical_position = position;
+        placement.vertical_anchor =
+            GetCueVerticalPositionAnchor( position_alignment );
+    }
+    SetCueLinePlacement( p_cue, &placement );
