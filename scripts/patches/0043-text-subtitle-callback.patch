+
+static void
+spu_ClearSubtitleTextSnapshot(spu_subtitle_text_snapshot *snapshot)
+{
+    for (size_t i = 0; i < snapshot->size; ++i)
+        free((void *) snapshot->data[i].region.text);
+    vlc_vector_clear(snapshot);
+}
+
+static bool
+spu_CopySubtitleTextSnapshot(const spu_subtitle_text_snapshot *snapshot,
+                             swiftvlc_subtitle_text_region_t **regions,
+                             size_t *region_count)
+{
+    *regions = NULL;
+    *region_count = 0;
+    if (snapshot->size == 0)
+        return true;
+
+    swiftvlc_subtitle_text_region_t *copy =
+        vlc_alloc(snapshot->size, sizeof(*copy));
+    if (copy == NULL)
+        return false;
+
+    for (size_t i = 0; i < snapshot->size; ++i)
+    {
+        copy[i] = snapshot->data[i].region;
+        copy[i].text = strdup(snapshot->data[i].region.text);
+        if (copy[i].text == NULL)
+        {
+            spu_ClearSubtitleTextRegions(copy, i);
+            return false;
+        }
+    }
+
+    *regions = copy;
+    *region_count = snapshot->size;
+    return true;
+}
+
+static bool
+spu_RemoveSubtitleTextSnapshotChannel(spu_subtitle_text_snapshot *snapshot,
+                                      size_t channel_id)
+{
+    bool removed = false;
+    for (size_t i = 0; i < snapshot->size;)
+    {
+        if (snapshot->data[i].channel_id != channel_id)
+        {
+            ++i;
+            continue;
+        }
+        free((void *) snapshot->data[i].region.text);
+        vlc_vector_remove(snapshot, i);
+        removed = true;
+    }
