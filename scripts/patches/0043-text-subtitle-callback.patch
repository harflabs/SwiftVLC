+                SWIFTVLC_WEBVTT_PLACEMENT_HAS_MAXIMUM_WIDTH;
+            placement.maximum_width = maximum;
+        }
+        else
+        {
+            placement.flags |=
+                SWIFTVLC_WEBVTT_PLACEMENT_HAS_MAXIMUM_HEIGHT;
+            placement.maximum_height = maximum;
+        }
+    }
+
+    placement.text_alignment = GetCueSwiftVLCTextAlignment( p_cue );
+    placement.writing_direction = GetCueWritingDirection( p_cue );
+    return placement;
+}
