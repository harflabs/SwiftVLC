+        .maximum_height = height,
+        .flags = SWIFTVLC_WEBVTT_PLACEMENT_HAS_MAXIMUM_WIDTH
+               | SWIFTVLC_WEBVTT_PLACEMENT_HAS_MAXIMUM_HEIGHT,
+        .horizontal_anchor = swiftvlc_webvtt_horizontal_anchor_left,
+        .vertical_anchor = swiftvlc_webvtt_vertical_anchor_top,
+        .text_alignment = GetCueSwiftVLCTextAlignment( p_cue ),
+        .writing_direction = swiftvlc_webvtt_writing_direction_horizontal,
+    };
