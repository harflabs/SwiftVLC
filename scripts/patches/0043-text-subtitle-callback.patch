+static swiftvlc_webvtt_text_alignment_t
+GetCueSwiftVLCTextAlignment( const webvtt_dom_cue_t *p_cue )
+{
+    const int alignment = GetCueTextAlignment( p_cue );
+    if( alignment & SUBPICTURE_ALIGN_LEFT )
+        return swiftvlc_webvtt_text_alignment_left;
+    if( alignment & SUBPICTURE_ALIGN_RIGHT )
+        return swiftvlc_webvtt_text_alignment_right;
+    return swiftvlc_webvtt_text_alignment_center;
+}
+
+static swiftvlc_webvtt_writing_direction_t
+GetCueWritingDirection( const webvtt_dom_cue_t *p_cue )
+{
+    if( p_cue->settings.vertical == WEBVTT_ALIGN_RIGHT )
+        return swiftvlc_webvtt_writing_direction_vertical_growing_left;
+    if( p_cue->settings.vertical == WEBVTT_ALIGN_LEFT )
+        return swiftvlc_webvtt_writing_direction_vertical_growing_right;
+    return swiftvlc_webvtt_writing_direction_horizontal;
+}
+
+static enum webvtt_align_e
+GetCuePositionAlignment( const webvtt_dom_cue_t *p_cue )
+{
+    if( p_cue->settings.positionalign != WEBVTT_ALIGN_AUTO )
+        return p_cue->settings.positionalign;
+
+    /* The decoder DOM does not retain the Unicode base direction needed to
+     * distinguish start/end for RTL cue text. Use the decoder's existing LTR
+     * assumption for logical anchors without treating vertical rl/lr as base
+     * direction. Explicit position anchors are preserved exactly. */
+    switch( p_cue->settings.align )
+    {
+        case WEBVTT_ALIGN_LEFT:
+        case WEBVTT_ALIGN_START:
+            return WEBVTT_ALIGN_LEFT;
+        case WEBVTT_ALIGN_RIGHT:
+        case WEBVTT_ALIGN_END:
+            return WEBVTT_ALIGN_RIGHT;
+        default:
+            return WEBVTT_ALIGN_CENTER;
+    }
+}
+
+static float GetCuePosition( const webvtt_dom_cue_t *p_cue )
+{
+    if( p_cue->settings.position >= 0 )
+        return p_cue->settings.position;
+
+    /* The WebVTT computed position depends only on physical left/right.
+     * start/end/default all use the midpoint; their computed position
+     * alignment is handled separately above. */
+    if( p_cue->settings.align == WEBVTT_ALIGN_LEFT )
+        return 0.f;
+    if( p_cue->settings.align == WEBVTT_ALIGN_RIGHT )
+        return 1.f;
+    return .5f;
+}
+
+static swiftvlc_webvtt_horizontal_anchor_t
+GetCueHorizontalPositionAnchor( enum webvtt_align_e alignment )
+{
+    if( alignment == WEBVTT_ALIGN_LEFT )
+        return swiftvlc_webvtt_horizontal_anchor_left;
+    if( alignment == WEBVTT_ALIGN_RIGHT )
+        return swiftvlc_webvtt_horizontal_anchor_right;
+    return swiftvlc_webvtt_horizontal_anchor_center;
+}
+
+static swiftvlc_webvtt_vertical_anchor_t
+GetCueVerticalPositionAnchor( enum webvtt_align_e alignment )
+{
+    if( alignment == WEBVTT_ALIGN_LEFT )
+        return swiftvlc_webvtt_vertical_anchor_top;
+    if( alignment == WEBVTT_ALIGN_RIGHT )
+        return swiftvlc_webvtt_vertical_anchor_bottom;
+    return swiftvlc_webvtt_vertical_anchor_center;
+}
+
+static float GetCueMaximumSize( const webvtt_dom_cue_t *p_cue,
+                                float position,
+                                enum webvtt_align_e alignment )
+{
+    float available;
+    if( alignment == WEBVTT_ALIGN_LEFT )
+        available = 1.f - position;
+    else if( alignment == WEBVTT_ALIGN_RIGHT )
+        available = position;
+    else
+    {
+        const float nearest_edge = position < .5f ? position : 1.f - position;
+        available = 2.f * nearest_edge;
+    }
