+    if( p_cue->settings.line.b_auto )
+    {
+        if( horizontal )
+        {
+            placement->vertical_position = 1.f;
+            placement->vertical_anchor =
+                swiftvlc_webvtt_vertical_anchor_bottom;
+        }
+        else if( p_cue->settings.vertical == WEBVTT_ALIGN_RIGHT )
+        {
+            placement->horizontal_position = 1.f;
+            placement->horizontal_anchor =
+                swiftvlc_webvtt_horizontal_anchor_right;
+        }
+        else
+        {
+            placement->horizontal_position = 0.f;
+            placement->horizontal_anchor =
+                swiftvlc_webvtt_horizontal_anchor_left;
+        }
+        return;
+    }
+
+    float line = p_cue->settings.line.value;
+    if( p_cue->settings.b_snap_to_lines )
+        line /= WEBVTT_REGION_LINES_COUNT * WEBVTT_LINE_TO_HEIGHT_RATIO;
+
+    if( horizontal )
+    {
+        placement->vertical_position = line >= 0.f ? line : 1.f + line;
+        if( p_cue->settings.linealign == WEBVTT_ALIGN_CENTER )
+            placement->vertical_anchor =
+                swiftvlc_webvtt_vertical_anchor_center;
+        else if( p_cue->settings.linealign == WEBVTT_ALIGN_END )
+            placement->vertical_anchor =
+                swiftvlc_webvtt_vertical_anchor_bottom;
+        else
+            placement->vertical_anchor =
+                swiftvlc_webvtt_vertical_anchor_top;
+    }
+    else
+    {
+        placement->horizontal_position =
+            p_cue->settings.vertical == WEBVTT_ALIGN_RIGHT
+                ? ( line >= 0.f ? 1.f - line : -line )
+                : ( line >= 0.f ? line : 1.f + line );
+        if( p_cue->settings.linealign == WEBVTT_ALIGN_CENTER )
+            placement->horizontal_anchor =
+                swiftvlc_webvtt_horizontal_anchor_center;
+        else
+        {
