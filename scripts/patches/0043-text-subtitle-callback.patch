+        && left->vertical_position == right->vertical_position
+        && left->maximum_width == right->maximum_width
+        && left->maximum_height == right->maximum_height
+        && left->flags == right->flags
+        && left->horizontal_anchor == right->horizontal_anchor
+        && left->vertical_anchor == right->vertical_anchor
+        && left->text_alignment == right->text_alignment
+        && left->writing_direction == right->writing_direction;
+}
+
+static bool
+spu_SubtitleTextRegionsAreEqual(const swiftvlc_subtitle_text_region_t *left,
+                                const swiftvlc_subtitle_text_region_t *right)
+{
+    if (left->placement != right->placement
+     || strcmp(left->text, right->text) != 0)
+        return false;
+
+    return left->placement != swiftvlc_subtitle_text_placement_webvtt
+        || spu_WebVTTPlacementsAreEqual(&left->webvtt, &right->webvtt);
+}
+
+static bool
+spu_SubtitleTextSnapshotsHaveEqualRegions(
+    const spu_subtitle_text_snapshot *left,
+    const spu_subtitle_text_snapshot *right)
+{
+    if (left->size != right->size)
+        return false;
+
+    for (size_t i = 0; i < left->size; ++i)
+    {
+        if (!spu_SubtitleTextRegionsAreEqual(&left->data[i].region,
+                                             &right->data[i].region))
+            return false;
+    }
+    return true;
+}
+
+static bool
+spu_SubtitleTextSnapshotsAreEqual(const spu_subtitle_text_snapshot *left,
+                                  const spu_subtitle_text_snapshot *right)
+{
+    if (!spu_SubtitleTextSnapshotsHaveEqualRegions(left, right))
+        return false;
+
+    for (size_t i = 0; i < left->size; ++i)
+        if (left->data[i].channel_id != right->data[i].channel_id)
+            return false;
+    return true;
+}
+
+static bool
+spu_CollectSubtitleText(spu_private_t *sys,
+                        size_t entry_count,
+                        const spu_render_entry_t *entries,
+                        swiftvlc_subtitle_text_region_t **regions,
+                        size_t *region_count,
+                        bool *changed)
+{
+    *regions = NULL;
+    *region_count = 0;
+    *changed = false;
+    if (!spu_IsSubtitleTextCaptureEnabled(sys))
+        return false;
+
+    spu_subtitle_text_snapshot snapshot;
+    vlc_vector_init(&snapshot);
+
+    for (size_t i = 0; i < entry_count; ++i)
+    {
+        const subpicture_t *subpic = entries[i].subpic;
+        if (!subpic->b_subtitle)
+            continue;
+
+        const subpicture_region_t *region;
+        vlc_spu_regions_foreach_const(region, &subpic->regions)
+        {
+            if (!spu_IsCapturedTextRegion(sys, subpic, region))
+                continue;
+
+            char *text;
+            if (!spu_CollectSubtitleTextRegion(region, &text))
+                goto error;
+            if (text == NULL)
+                continue;
+
+            struct spu_subtitle_text_snapshot_entry snapshot_entry = {
+                .channel_id = (size_t) subpic->i_channel,
+                .region = {
+                    .text = text,
+                    .placement = swiftvlc_subtitle_text_placement_automatic,
+                },
+            };
+            if (region->b_swiftvlc_webvtt_placement)
+            {
+                snapshot_entry.region.placement =
+                    swiftvlc_subtitle_text_placement_webvtt;
+                snapshot_entry.region.webvtt =
+                    region->swiftvlc_webvtt_placement;
+            }
+            if (!vlc_vector_push(&snapshot, snapshot_entry))
+            {
+                free(text);
+                goto error;
+            }
+        }
+    }
+
+    if (spu_SubtitleTextSnapshotsHaveEqualRegions(
+            &snapshot, &sys->subtitle_text_snapshot))
+    {
+        if (spu_SubtitleTextSnapshotsAreEqual(
+                &snapshot, &sys->subtitle_text_snapshot))
+            spu_ClearSubtitleTextSnapshot(&snapshot);
+        else
+        {
+            spu_ClearSubtitleTextSnapshot(&sys->subtitle_text_snapshot);
+            sys->subtitle_text_snapshot = snapshot;
+        }
+        return true;
+    }
+
+    if (!spu_CopySubtitleTextSnapshot(&snapshot, regions, region_count))
+    {
+        spu_ClearSubtitleTextSnapshot(&snapshot);
+        return false;
+    }
+
+    spu_ClearSubtitleTextSnapshot(&sys->subtitle_text_snapshot);
+    sys->subtitle_text_snapshot = snapshot;
+    *changed = true;
+    return true;
+
+error:
+    for (size_t i = 0; i < snapshot.size; ++i)
+        free((void *) snapshot.data[i].region.text);
+    vlc_vector_destroy(&snapshot);
+    return false;
+}
