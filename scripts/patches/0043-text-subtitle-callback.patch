+                p_cue->settings.linealign != WEBVTT_ALIGN_END;
+            const bool right =
+                ( p_cue->settings.vertical == WEBVTT_ALIGN_RIGHT ) == start;
+            placement->horizontal_anchor = right
+                ? swiftvlc_webvtt_horizontal_anchor_right
+                : swiftvlc_webvtt_horizontal_anchor_left;
+        }
+    }
