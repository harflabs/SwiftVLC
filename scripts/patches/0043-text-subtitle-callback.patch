+bool
+swiftvlc_libvlc_media_player_set_subtitle_text_snapshot_callback(
+    libvlc_media_player_t *p_mi,
+    swiftvlc_subtitle_text_snapshot_cb callback,
+    void *opaque )
+{
+    if (p_mi == NULL)
+        return false;
+
+    vlc_player_t *player = p_mi->player;
+    vlc_player_Lock(player);
+
+    struct swiftvlc_subtitle_text_registration *registration =
+        &p_mi->subtitle_text_registration;
+    if (registration->latched)
+    {
+        vlc_player_Unlock(player);
+        return false;
+    }
+
+    registration->callback = callback;
+    registration->opaque = callback != NULL ? opaque : NULL;
+
+    vlc_player_Unlock(player);
+    return true;
+}
