+static bool
+spu_CollectSubtitleTextRegion(const subpicture_region_t *region, char **text)
+{
+    *text = NULL;
+    bool has_segment = false;
+    for (const text_segment_t *segment = region->p_text;
+         segment != NULL; segment = segment->p_next)
+    {
+        if (segment->psz_text != NULL && segment->psz_text[0] != '\0')
+        {
+            has_segment = true;
+            break;
+        }
+    }
+    if (!has_segment)
+        return true;
+
+    struct vlc_memstream stream;
+    if (vlc_memstream_open(&stream) != 0)
+        return false;
+
+    for (const text_segment_t *segment = region->p_text;
+         segment != NULL; segment = segment->p_next)
+    {
+        if (segment->psz_text != NULL && segment->psz_text[0] != '\0')
+            vlc_memstream_puts(&stream, segment->psz_text);
+    }
+
+    if (vlc_memstream_close(&stream) != 0)
+        return false;
+    *text = stream.ptr;
+    return true;
+}
