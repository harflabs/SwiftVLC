+static struct spu_subtitle_text_update
+spu_PrepareSubtitleTextUpdate(spu_private_t *sys,
+                              swiftvlc_subtitle_text_region_t *regions,
+                              size_t region_count)
+{
+    struct swiftvlc_subtitle_text_registration *registration =
+        sys->subtitle_text_registration;
+    struct spu_subtitle_text_update update = {
+        .regions = regions,
