# An input that presented something and reached its end ended naturally.
#
# Patch 0020 records the first failure of any stream and patch 0046 clears it
# again on recovery. Two consequences were wrong for every failure that never
# recovers while the input keeps playing (no drawable was ever attached, a
# selected track has no decoder, an external subtitle file is missing):
#
# - vlc_player_GetError() returned the recorded failure at once, so
#   libvlc_media_player_get_state() reported Error for the rest of a healthy
#   session and callers that branch on Playing/Paused refused to resume or
#   seek;
# - a clean END_S was converted into an error, so a file that played to its
#   last sample ended with EncounteredError instead of end of stream.
#
# A recorded failure is now an error only once it ended the input. At END_S an
# input that published at least one output clock point ended naturally; only
# an input that never presented anything fails, with its unresolved failure
# or, when it exposed no elementary stream and no sub-item at all (corrupt or
# unrecognised data), a demux failure. A late END_S after a user stop no
# longer rewrites the user's stopping reason. A terminal ERROR_S is attributed
# to the access or demux failure that caused it, not to an unrelated stream
# that failed earlier.
--- a/src/player/player.h
+++ b/src/player/player.h
@@ -68,6 +68,11 @@
     enum vlc_player_error error;
     bool error_reported;
     struct vlc_player_input_failures failures;
+    /* An output clock published a point, so something was presented. Set by
+     * output threads without the player lock. */
+    atomic_bool presented;
+    /* The input exposed an elementary stream or sub-items. */
+    bool has_content;
     enum vlc_player_media_stopping_reason stopping_reason;
     float rate;
     int capabilities;
--- a/src/player/input_failure.h
+++ b/src/player/input_failure.h
@@ -61,4 +61,20 @@
         default: return VLC_PLAYER_ERROR_GENERIC;
     }
 }
+
+/* A terminal input error comes from the access or the demux. An unrelated
+ * stream that failed earlier (a decoder without an output, a missing
+ * subtitle file) must not relabel it. */
+static inline enum vlc_player_error
+vlc_player_input_TerminalFailure(const struct vlc_player_input_failures *state)
+{
+    for (unsigned i = 0; i < state->length; ++i)
+    {
+        if (state->order[i] == VLC_INPUT_FAILURE_DEMUX)
+            return VLC_PLAYER_ERROR_DEMUX;
+        if (state->order[i] == VLC_INPUT_FAILURE_SOURCE)
+            return VLC_PLAYER_ERROR_SOURCE;
+    }
+    return vlc_player_input_CurrentFailure(state);
+}
 #endif
