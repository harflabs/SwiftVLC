@@ -84,6 +84,8 @@
     bool clock_nowait; /* protected by vlc_clock_Lock()/vlc_clock_Unlock() */
     bool wait_interrupted;
     bool first_picture;
+    /* No picture was rendered since the display started or was flushed. */
+    bool paused_point_pending;
 
     vlc_clock_t     *clock;
     vlc_clock_listener_id *clock_listener_id;
@@ -1816,10 +1818,14 @@
         sys->displayed.date = system_now;
     }
 
-    /* Every picture rendered while paused is an exact output point, including
-     * the first picture after a seek. Let it override the dormant audio clock
-     * without interpolating or advancing that clock. */
-    if (render_type == RENDER_PICTURE_NEXT || sys->pause.is_on)
+    /* The first picture rendered while paused after a seek is an exact output
+     * point. Let it override the dormant audio clock without interpolating or
+     * advancing that clock. Later renders of a paused picture are redisplays:
+     * the picture can be much older than the audio position (a video track
+     * that ended early, a long-lived frame of a slideshow or screen
+     * recording), so they must not move the published time back to it. */
+    if (render_type == RENDER_PICTURE_NEXT
+     || (sys->pause.is_on && sys->paused_point_pending))
         system_now = VLC_TICK_MAX;
     else
         system_now = vlc_tick_now();
@@ -1849,6 +1855,7 @@
