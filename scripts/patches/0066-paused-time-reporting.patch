         return VLC_EGENERIC;
     }
+    sys->paused_point_pending = false;
     const bool capture_strict_timing = render_type == RENDER_PICTURE_NEXT
         && !submission_unproven && vout_IsStrictFrameTarget(sys);
     struct vlc_clock_frame_step_capture capture = { 0 };
@@ -2133,6 +2140,7 @@
     picture_fifo_Lock(sys->decoder_fifo);
