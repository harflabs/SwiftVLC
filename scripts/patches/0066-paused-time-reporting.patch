# Report the right time while paused.
#
# Patch 0049 published every picture rendered while paused as a forced clock
# point. That is right for the first picture after a seek, but the same code
# also runs for the periodic redisplay of a paused picture: when that picture
# is older than the audio position (a video track that ended early, a
# long-lived frame of a slideshow or screen recording) the published time
# jumped back to its timestamp as soon as playback paused. Only the first
# render after a flush is a forced point now.
#
# A seek while paused without a video output (audio only, or video whose
# output never opened) publishes no point until playback resumes, so the time
# and position getters kept returning the position before the seek. While
# paused they now return the pending seek target until a real point arrives,
# as relative seeks already do internally.
#
# A paused render still in flight when the main clock resumes carries the
# forced-point marker instead of a date; it no longer reaches the monotonic
# fallback as a date.
--- a/src/player/player.c
+++ b/src/player/player.c
@@ -1703,7 +1703,12 @@
     if (!input)
         return VLC_TICK_INVALID;
 
-    return vlc_player_input_GetTime(input, false, vlc_tick_now());
+    /* While paused, a seek without a video output (audio only, or video whose
+     * output never opened) publishes no point until playback resumes, and the
+     * last point still describes the position before the seek. Report the
+     * pending target instead. */
+    return vlc_player_input_GetTime(
+        input, input->state == VLC_PLAYER_STATE_PAUSED, vlc_tick_now());
 }
 
 double
@@ -1711,7 +1716,8 @@
 {
     struct vlc_player_input *input = vlc_player_get_input_locked(player);
 
-    return input ? vlc_player_input_GetPos(input, false, vlc_tick_now()) : -1.f;
+    return input ? vlc_player_input_GetPos(
+        input, input->state == VLC_PLAYER_STATE_PAUSED, vlc_tick_now()) : -1.f;
 }
 
 void
