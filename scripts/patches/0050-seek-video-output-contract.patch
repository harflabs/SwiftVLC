+void
+vlc_player_NotifyVideoOutput(vlc_player_t *player, vlc_tick_t time,
+                             double position, vlc_tick_t frame_duration)
+{
+    vlc_mutex_lock(&player->timer.lock);
+    if (!player->timer.stopping && !player->timer.best_source.seeking)
+    {
+        const struct vlc_player_timer_point point = {
+            .ts = time,
+            .position = position,
+            .length = player->timer.input_length,
+            .live = player->timer.input_live,
+            .rate = player->timer.best_source.point.rate,
+            .system_date = VLC_TICK_MAX,
+        };
+        vlc_player_timer_id *timer;
+        vlc_list_foreach(timer, &player->timer.best_source.listeners, node)
+            if (timer->on_video_output != NULL)
+                timer->on_video_output(&point, frame_duration, timer->data);
+    }
+    vlc_mutex_unlock(&player->timer.lock);
+}
