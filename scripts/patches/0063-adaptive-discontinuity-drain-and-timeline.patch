+                    fakeEsOut()->setSegmentStartTimes(currentTimeContext);
+                    fakeEsOut()->setSynchronizationReference(
+                        SynchronizationReference(currentSequence, Times()));
                 }
                 assert(startTimeContext.media);
                 if(!fakeEsOut()->hasSegmentStartTimes())
