# CoreAudio play() queued the whole caching delay of audio already
# time-stretched at the current rate, and reported its timing once a second,
# so a rate change took one to two seconds to become audible, then the audio
# clock stepped back and stalled video. Bound the output queue once rendering
# runs, leaving the rest in the decoder (outside the iOS lifecycle lock), and
# report timing every 100 ms.
diff --git a/modules/audio_output/apple/audiounit_ios.m b/modules/audio_output/apple/audiounit_ios.m
--- a/modules/audio_output/apple/audiounit_ios.m
+++ b/modules/audio_output/apple/audiounit_ios.m
@@ -1023,6 +1023,7 @@ static void
 Play(audio_output_t * p_aout, block_t * p_block, vlc_tick_t date)
 {
     aout_sys_t *p_sys = p_aout->sys;
+    ca_WaitOutputQueue(p_aout); /* may sleep: not under lifecycle_lock */
     vlc_mutex_lock(&p_sys->lifecycle_lock);
     bool quarantined = p_sys->media_services_lost
                     || p_sys->media_services_rebuild_pending
diff --git a/modules/audio_output/apple/coreaudio_common.c b/modules/audio_output/apple/coreaudio_common.c
--- a/modules/audio_output/apple/coreaudio_common.c
+++ b/modules/audio_output/apple/coreaudio_common.c
@@ -27,7 +27,10 @@
 #include <vlc_apple_audio_session.h>
 #include <CoreAudio/CoreAudioTypes.h>
 
-#define TIMING_REPORT_DELAY_TICKS VLC_TICK_FROM_MS(1000)
+/* Interval between timing reports to the clock. At one second, the audio
+ * master clock kept extrapolating the previous rate for up to a second after a
+ * rate change became audible, then stepped back, stalling video. */
+#define TIMING_REPORT_DELAY_TICKS VLC_TICK_FROM_MS(100)
 
 static inline uint64_t
 BytesToFrames(struct aout_sys_common *p_sys, size_t i_bytes)
@@ -88,6 +91,12 @@ ca_ClearOutBuffers(audio_output_t *p_aout)
     p_sys->pp_out_last = &p_sys->p_out_chain;
 }
 
+/* Output queue bound once rendering runs, how often to check it, and the
+ * longest a single play call waits for the render callback to drain it. */
+#define CA_MAX_QUEUED_TICKS VLC_TICK_FROM_MS(300)
+#define CA_QUEUE_POLL_TICKS VLC_TICK_FROM_MS(10)
+#define CA_MAX_QUEUE_WAIT_TICKS VLC_TICK_FROM_SEC(1)
+
 static inline void
 lock_init(struct aout_sys_common *p_sys)
 {
@@ -115,6 +124,9 @@ lock_unlock(struct aout_sys_common *p_sys)
         vlc_mutex_unlock(&p_sys->lock.mutex);
 }
 
+static void
+ca_PlayQueued(audio_output_t *p_aout, block_t *p_block, vlc_tick_t date);
+
 int
 ca_Open(audio_output_t *p_aout)
 {
@@ -130,7 +142,7 @@ ca_Open(audio_output_t *p_aout)
     p_sys->pp_out_last = &p_sys->p_out_chain;
     p_sys->chans_to_reorder = 0;
 
-    p_aout->play = ca_Play;
+    p_aout->play = ca_PlayQueued;
     p_aout->pause = ca_Pause;
     p_aout->flush = ca_Flush;
     p_aout->time_get = NULL;
@@ -271,7 +283,7 @@ ca_Render(audio_output_t *p_aout, uint64_t host_time,
     {
         p_sys->timing_report_last_written_bytes = 0;
 
-        /* From now on, fetch the timestamp every 1 seconds */
+        /* From now on, report the timing periodically */
         p_sys->timing_report_delay_bytes =
             TicksToBytes(p_sys, TIMING_REPORT_DELAY_TICKS);
 
@@ -327,6 +339,38 @@ ca_MuteSet(audio_output_t * p_aout, bool muted)
     lock_unlock(p_sys);
 }
 
+void
+ca_WaitOutputQueue(audio_output_t *p_aout)
+{
+    struct aout_sys_common *p_sys = (struct aout_sys_common *) p_aout->sys;
+
+    /* Keep only a short output queue once rendering runs. Unbounded, it held
+     * the whole caching delay of audio already time-stretched at the current
+     * rate, so a rate change only became audible (and moved the clock) one to
+     * two seconds later. Bounded, the remaining audio stays in the decoder.
+     * The render callback never waits or signals: poll, and give up when it
+     * stops pulling (stopped or interrupted device). */
+    lock_lock(p_sys);
+    const size_t max_queued = TicksToBytes(p_sys, CA_MAX_QUEUED_TICKS);
+    for (vlc_tick_t waited = 0;
+         p_sys->started && !p_sys->b_paused && p_sys->i_out_size > max_queued
+         && waited < CA_MAX_QUEUE_WAIT_TICKS;
+         waited += CA_QUEUE_POLL_TICKS)
+    {
+        lock_unlock(p_sys);
+        vlc_tick_sleep(CA_QUEUE_POLL_TICKS);
+        lock_lock(p_sys);
+    }
+    lock_unlock(p_sys);
+}
+
+static void
+ca_PlayQueued(audio_output_t *p_aout, block_t *p_block, vlc_tick_t date)
+{
+    ca_WaitOutputQueue(p_aout);
+    ca_Play(p_aout, p_block, date);
+}
+
 void
 ca_Play(audio_output_t * p_aout, block_t * p_block, vlc_tick_t date)
 {
diff --git a/modules/audio_output/apple/coreaudio_common.h b/modules/audio_output/apple/coreaudio_common.h
--- a/modules/audio_output/apple/coreaudio_common.h
+++ b/modules/audio_output/apple/coreaudio_common.h
@@ -116,6 +116,10 @@ void ca_Uninitialize(audio_output_t *p_aout);
 
 void ca_SetAliveState(audio_output_t *p_aout, bool alive);
 
+/* Waits while the output queue exceeds a short bound; never call it with a
+ * lock the render path or another thread may need. */
+void ca_WaitOutputQueue(audio_output_t *p_aout);
+
 void ca_ResetDeviceLatency(audio_output_t *p_aout);
 
 AudioUnit au_NewOutputInstance(audio_output_t *p_aout, OSType comp_sub_type);
