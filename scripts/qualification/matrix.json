    {
      "id": "cadence-matrix",
      "issues": [102],
      "hardware": ["iphone-current"],
      "minimumDurationSeconds": 600,
      "summary": "23.976/24/25/29.97/30/50/59.94/60 fps and VFR cadence through rate, pause, replacement, and resize transitions",
      "requiredEvidenceFields": [
        "rates",
        "vfr",
        "presentationMetrics",
